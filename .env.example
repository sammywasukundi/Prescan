# ─────────────────────────────────────────────────────────────
# Référence des variables d'environnement PreScan.
# Ne JAMAIS commiter de vraies valeurs. Chaque service a son propre fichier :
#   web/.env.local            → frontend Next.js
#   inference-api/.env        → API FastAPI
#   supabase secrets set ...  → Edge Functions
# ─────────────────────────────────────────────────────────────

# ── Frontend (web/.env.local) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon>

# ── Edge Functions (supabase secrets set KEY=valeur) ─────────
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement.
INFERENCE_API_URL=https://prescan-inference.example.com
INFERENCE_SERVICE_TOKEN=<secret partagé, 32+ caractères aléatoires>
INFERENCE_TIMEOUT_MS=30000
ALLOWED_ORIGIN=https://prescan.example.com
ANTHROPIC_API_KEY=<clé pour le chat RAG>
RAG_LLM_MODEL=claude-sonnet-5-5

# ── API d'inférence (inference-api/.env) ─────────────────────
PRESCAN_SERVICE_TOKEN=<même valeur que INFERENCE_SERVICE_TOKEN>
PRESCAN_DEFAULT_MODEL_VERSION=densenet121-v1
PRESCAN_ALLOW_DUMMY_MODEL=true   # false en production : refuse de démarrer sans vrais poids
PRESCAN_MAX_IMAGE_BYTES=10485760
PRESCAN_DEVICE=cpu
PRESCAN_ENABLE_DOCS=false
