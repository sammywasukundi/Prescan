# Image pour Hugging Face Spaces (SDK Docker). À copier sous le nom `Dockerfile` à la racine du Space.
# Les Spaces exécutent le conteneur avec l'utilisateur 1000 et exposent le port 7860.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TF_CPP_MIN_LOG_LEVEL=2 \
    PORT=7860 PRESCAN_ALLOW_DUMMY_MODEL=false

RUN useradd --create-home --uid 1000 user
WORKDIR /home/user/app

COPY requirements.txt requirements-ml.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ml.txt

COPY --chown=user app ./app
COPY --chown=user configs ./configs

USER user
EXPOSE 7860
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
